outputDir = '/data/xrz/capint/output_survirus'

cleanup = false
workflow.output.mode = 'copy'

// Processes that call bioinformatics software use the existing environment
// selected by params.survirus_conda in main.nf.
conda.enabled = true

report.overwrite = true
timeline.overwrite = true

process {
    cpus = 16
    maxForks = 6
    errorStrategy = 'terminate'   // stop on error so failures are not silently masked

    // Each RUN_SURVIRUS task creates a full hg38+HBV BWA index.  Keep the
    // default I/O and temporary-disk demand manageable; override if desired.
    withName: 'RUN_SURVIRUS' {
        maxForks = 6
    }

    // The Python-2-compatible Cutadapt release used by SurVirus cannot use
    // multiple workers (see CUTADAPT's explicit -j 1 setting in main.nf).
    withName: 'CUTADAPT' {
        cpus = 1
    }


    // withName: 'CUTADAPT' {
    //     cpus = 6
    //     memory = '12 GB'
    // }


}
